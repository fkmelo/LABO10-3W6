@model int
<div class="col">
    @if (Model == 0)
    {
        <button type="submit" class="btn btn-success w-100"><i class="fa-solid fa-plus"></i>&nbsp;Create </button>
    }
    else
    {
        <button type="submit" class="btn btn-info w-100"><i class="fa-solid fa-pen-to-square"></i>&nbsp;Edit </button>
    }
</div>
<div class="col">
    <a asp-action="Index" class="btn btn-secondary w-100"><i class="fa-solid fa-circle-arrow-left"></i>&nbsp;Back to list</a>
</div>
